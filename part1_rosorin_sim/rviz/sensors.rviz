Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 300
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.4
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR /scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR /scan/points
      Enabled: true
      Topic:
        Value: /scan/points
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.03
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 60
      Shape:
        Value: Arrow
        Shaft Length: 0.2
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.03
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Depth camera
      Enabled: true
      Topic:
        Value: /depth_cam/depth_cam
        Reliability Policy: Best Effort
      Normalize Range: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 48
    Fixed Frame: odom
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Focal Point:
        X: 0.5
        Y: 0.0
        Z: 0.0
      Pitch: 0.9
      Yaw: 3.6
      Target Frame: base_footprint
    Saved: ~
Window Geometry:
  Height: 1080
  Width: 960
